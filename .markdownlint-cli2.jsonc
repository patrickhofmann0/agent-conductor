// GUARDRAIL FILE. Changes require the `guardrails-change` label. See docs/adr/0011.
{
  "config": {
    "extends": "markdownlint/style/prettier",
    "default": true,
    // Line length is handled by Prettier.
    "MD013": false,
    // Allow the same heading text in different sections (e.g. "Consequences").
    "MD024": { "siblings_only": true },
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "reports/**",
    ".stryker-tmp/**",
  ],
  "gitignore": true,
}
