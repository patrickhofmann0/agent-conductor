{
  "name": "agent-conductor",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "BUN_INSTALL": "/home/node/.bun"
  },
  "remoteEnv": {
    "PATH": "/home/node/.bun/bin:${containerEnv:PATH}"
  },
  "mounts": [
    {
      "source": "agent-conductor-opencode-data-${devcontainerId}",
      "target": "/home/node/.local/share/opencode",
      "type": "volume"
    },
    {
      "source": "agent-conductor-opencode-config-${devcontainerId}",
      "target": "/home/node/.config/opencode",
      "type": "volume"
    },
    {
      "source": "agent-conductor-opencode-state-${devcontainerId}",
      "target": "/home/node/.local/state/opencode",
      "type": "volume"
    },
    {
      "source": "agent-conductor-gh-config-${devcontainerId}",
      "target": "/home/node/.config/gh",
      "type": "volume"
    }
  ],
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postCreateCommand": "bun install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
        "typescript.tsdk": "node_modules/typescript/lib",
        "terminal.integrated.sendKeybindingsToShell": true
      }
    }
  },
  "remoteUser": "node"
}
